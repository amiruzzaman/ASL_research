---
import Layout from "../layouts/Layout.astro";
import ASLCanvas from "../components/ASLCanvas.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  class="flex flex-col justify-center items-center overflow-hidden max-h-3/4"
  title="English to ASL"
>
  <button
    id="word-template"
    style="display: none;"
    class="data-active:btn-accent btn-soft data-unknown:btn-disabled carousel-item btn"></button>
  <div class="bg-base-200 shadow-sm w-full max-w-3/4 p-8 flex flex-col has-checked:grow">
    <input class="peer hidden" id="app-screen" type="checkbox" />
    <div
      class="md:py-32 peer-checked:hidden peer-indeterminate:hidden items-center justify-center flex flex-col w-full md:flex-row"
    >
      <div class="flex flex-col p-4 justify-center items-center gap-2 text-center">
        
        <button class="btn btn-primary btn-block" id="submit">Play</button>
      </div>
      <div class="divider md:divider-horizontal px-4">Or</div>
      <div class="p-4 text-center flex flex-col gap-2 items-center justify-center">
        <button id="mic" class="btn btn-primary peer">
          <Icon name="tabler:microphone" />
          Use Microphone
        </button>
        <div role="alert" class="hidden peer-disabled:block alert alert-soft alert-error">
          Not Supported On Your Browser
        </div>
      </div>
    </div>
    <div
      class="hidden peer-indeterminate:flex w-full h-full flex-col gap-8 items-center justify-center"
    >
      <p class="text-4xl">Loading</p>
      <progress id="progress" class="progress"></progress>
    </div>
    
  </div>
</Layout>


