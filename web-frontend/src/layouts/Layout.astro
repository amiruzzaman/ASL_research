---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

import "../styles/global.css";

export interface Props extends HTMLAttributes<"main"> {
  title: string;
}

const { title, class: className, ...rest } = Astro.props;
const desc = "Convert ASL to English and vice versa by recording yourself.";

const navLinks = {
  "English to ASL": ["tabler:speakerphone", "/e2a"],
  "Record ASL": ["tabler:video-plus", "/record"],
  "ASL to English": ["tabler:hand-stop", "/a2e"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content="ASL Research Project" />
  </head>

  <body class="container mx-auto flex flex-col min-h-screen max-h-screen">
    <header class="mb-4">
      <nav class="navbar bg-base-100 shadow-sm">
        <div class="navbar-start">
          <a class="btn btn-soft btn-xl text-xl p-2 tooltip tooltip-right" data-tip="Home" href="/">
            <img class="max-h-full" src="/favicon.svg" alt="A rainbow colored hand waving" />
          </a>
        </div>
        <div class="navbar-center flex gap-4">
          {
            Object.entries(navLinks).map(([title, [icon, href]]) => (
              <a
                href={href}
                class="btn btn-xl text-xl btn-soft tooltip tooltip-bottom"
                data-tip={title}
              >
                <Icon class="text-xl" name={icon} />
              </a>
            ))
          }
        </div>
        <div class="navbar-end">
          <a
            class="btn btn-soft btn-xl text-xl tooltip tooltip-left"
            data-tip="GitHub Repo"
            target="_blank"
            href="https://github.com/amiruzzaman/ASL_research"
          >
            <Icon class="text-xl" name="tabler:brand-github" />
          </a>
        </div>
      </nav>
    </header>
    <main class:list={["grow", className]} {...rest}>
      <slot />
    </main>
    <footer class="h-10"></footer>
  </body>
</html>
